{
  "name": "read-paper",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "productName": "Papertrail",
  "description": "Local-first paper reading and research workspace",
  "author": "alovwang-sys",
  "license": "SEE LICENSE IN LICENSE",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "ai": "node server/ai.mjs",
    "test:server": "node --test server/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/create-fixtures.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make": "npm run build && electron-forge make",
    "test:desktop": "node --test desktop/*.test.mjs",
    "test:desktop:e2e": "playwright test --config playwright.desktop.config.ts",
    "predev": "node scripts/prepare-drawing-assets.mjs",
    "prebuild": "node scripts/prepare-drawing-assets.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "electron-squirrel-startup": "1.0.1",
    "fflate": "0.8.3",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "@excalidraw/excalidraw": "0.18.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.1.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20",
      "sass": "1.79.6"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  }
}
